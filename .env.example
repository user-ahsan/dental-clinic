# ── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Private (SERVER ONLY — NEVER exposed to client-side code)
# This key has admin privileges. Only use in secure server contexts:
# - API routes (src/app/api/)
# - Server Components with 'use server'
# - Edge Functions
# NEVER prefix this with NEXT_PUBLIC_ — it would be bundled into client JS
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ── Redis (BullMQ job queue) ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Database Connection Pool (used by PM2 / direct PostgreSQL connections) ───
DATABASE_URL=postgresql://postgres:your-password@localhost:54322/postgres
# Supabase pooler connection (transaction mode, port 6543 in production)
# SUPABASE_POOLER_URL=postgresql://postgres.your-ref:your-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT=30000
DB_POOL_CONNECTION_TIMEOUT=10000
